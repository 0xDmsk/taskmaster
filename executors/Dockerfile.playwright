FROM --platform=linux/arm64 python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99

# Install noVNC stack plus Playwright browser dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      openssl \
      fluxbox \
      novnc \
      websockify \
      x11vnc \
      xvfb && \
    rm -rf /var/lib/apt/lists/*

# -------- Burp Suite CA (optional) --------
# Drop your DER-exported Burp CA at executors/burp-cacert.der and it will be
# installed into the system trust store so Chromium accepts Burp's MITM cert.
# Gitignored — per-developer. The wildcard pattern (BuildKit) makes the COPY
# a no-op when the file is absent.
COPY executors/burp-cacert.de[r] /tmp/burp-cacert.der
RUN if [ -s /tmp/burp-cacert.der ]; then \
        openssl x509 -inform DER -in /tmp/burp-cacert.der \
            -out /usr/local/share/ca-certificates/burp-cacert.crt && \
        update-ca-certificates; \
    fi && \
    rm -f /tmp/burp-cacert.der

# Three browser engines, in evasion-tier order:
#   playwright  — vanilla Chromium. Cheapest, easiest fingerprint to detect.
#   patchright  — drop-in Playwright fork with anti-detection patches (Chromium).
#   camoufox    — custom-built Firefox tuned for fingerprint resistance.
# Skills/scripts pick at run time via the BROWSER_ENGINE env var (default
# patchright). Installing all three means one image serves the full ladder.
RUN pip install --no-cache-dir \
        playwright \
        patchright \
        "camoufox[geoip]" && \
    playwright install chromium --with-deps && \
    playwright install firefox --with-deps && \
    patchright install chromium && \
    python -m camoufox fetch && \
    rm -rf /var/lib/apt/lists/*

# -------- Taskmaster Integration --------
COPY skills /app/skills
COPY targeting.py /app/targeting.py
ENV PYTHONPATH=/app:$PYTHONPATH

COPY executors/playwright_operator.py /usr/local/bin/playwright-operator
COPY executors/playwright_entrypoint.sh /usr/local/bin/playwright-entrypoint
RUN chmod +x /usr/local/bin/playwright-operator
RUN chmod +x /usr/local/bin/playwright-entrypoint

WORKDIR /work
EXPOSE 5900 6080
CMD ["/usr/local/bin/playwright-entrypoint"]
