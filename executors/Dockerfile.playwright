FROM --platform=linux/arm64 python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99

# Install noVNC stack plus Playwright browser dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      fluxbox \
      novnc \
      websockify \
      x11vnc \
      xvfb && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir playwright && \
    playwright install chromium --with-deps && \
    rm -rf /var/lib/apt/lists/*

# -------- Taskmaster Integration --------
COPY skills /app/skills
COPY targeting.py /app/targeting.py
ENV PYTHONPATH=/app:$PYTHONPATH

COPY executors/playwright_operator.py /usr/local/bin/playwright-operator
COPY executors/playwright_entrypoint.sh /usr/local/bin/playwright-entrypoint
RUN chmod +x /usr/local/bin/playwright-operator
RUN chmod +x /usr/local/bin/playwright-entrypoint

WORKDIR /work
EXPOSE 5900 6080
CMD ["/usr/local/bin/playwright-entrypoint"]
