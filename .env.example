# Taskmaster Configuration
# Copy this file to .env and customize for your environment

# MCP endpoint — IP/hostname that Docker containers can use to reach this host.
# This listener carries JSON-RPC from agent containers, so it must bind an
# interface the containers can reach (default 0.0.0.0), NOT loopback.
# Docker Desktop (macOS/Windows): host.docker.internal (default)
# Linux: use the docker0 bridge IP (e.g. 172.17.0.1)
# TASKMASTER_HOST=host.docker.internal
# TASKMASTER_PORT=5000

# Dashboard — served on a SEPARATE listener from the MCP endpoint so it can bind
# loopback-only (default 127.0.0.1:5001) and stay off the network. Agents never
# use this port. Open http://127.0.0.1:5001 in your browser.
# TASKMASTER_DASHBOARD_HOST=127.0.0.1
# TASKMASTER_DASHBOARD_PORT=5001

# Work Directory — where assessment output goes. All runtime artifacts land
# under <WORK_DIR>/runtime/ (loot/, reports/, audit/, state/) so each
# engagement folder stays self-contained. Defaults to the current working
# directory if not set; point this at the engagement folder you're running
# the server for.
# TASKMASTER_WORK_DIR=/path/to/engagement

# Proxy for spawned agent containers is OPT-IN per spawn_agent call.
# Pass proxy_url="http://host.docker.internal:8080" (or similar) to
# spawn_agent when you want traffic to flow through Burp or another
# intercepting proxy. Setting HTTP_PROXY in this file has no effect on
# agent containers; container traffic is routed by Docker by default.

# Optional: Mount SecLists wordlists into agent containers
# SECLISTS_PATH=/path/to/seclists

# Session material for agents — cookie exports, Playwright storage_state,
# auth token files. Drop files in this directory on the host; every spawned
# agent sees them read-only at /session (never passed through the spawn
# payload or audit log). Defaults to <WORK_DIR>/runtime/session/. Playwright
# agents auto-load <SESSION_DIR>/storage_state.json into each browser context.
# For a shared server across many project folders, prefer passing session_dir
# (an absolute host path) per spawn_agent call instead of setting this globally.
# TASKMASTER_SESSION_DIR=/path/to/session

# Wait-for-completion tuning (defaults are fine for most cases)
# WAIT_DEFAULT_TIMEOUT=600   # Server-side wait timeout (seconds)
# WAIT_POLL_INTERVAL=2       # How often the server polls state (seconds)
# MCP_BRIDGE_TIMEOUT=900     # HTTP bridge read timeout — must exceed WAIT_DEFAULT_TIMEOUT

# Agent reaper — stops idle/stale/over-aged agent containers in the background
# TASKMASTER_REAPER_ENABLED=true
# TASKMASTER_REAPER_INTERVAL=60        # seconds between reaper passes
# TASKMASTER_REAPER_IDLE_TIMEOUT=900   # 15 min: container with no claimed work → reap
# TASKMASTER_REAPER_STALE_TIMEOUT=7200 # 2 h: claimed work whose updated_at is older → reap + fail
# TASKMASTER_REAPER_MAX_AGE=14400      # 4 h: hard cap regardless of state
# TASKMASTER_REAPER_ORPHAN_TIMEOUT=300 # 5 min: CLAIMED/RUNNING row whose container is gone → fail (frees target lock)
