# Taskmaster Configuration
# Copy this file to .env and customize for your environment

# MCP Server — IP/hostname that Docker containers can use to reach this host
# Docker Desktop (macOS/Windows): host.docker.internal (default)
# Linux: use the docker0 bridge IP (e.g. 172.17.0.1)
# TASKMASTER_HOST=host.docker.internal
# TASKMASTER_PORT=5000

# Work Directory — where assessment output goes (state DB, audit logs, loot).
# Defaults to the current working directory if not set.
# TASKMASTER_WORK_DIR=/path/to/assessments

# Optional: Proxy passed to spawned agent containers
# HTTP_PROXY=http://127.0.0.1:8080

# Optional: Mount SecLists wordlists into agent containers
# SECLISTS_PATH=/path/to/seclists

# Wait-for-completion tuning (defaults are fine for most cases)
# WAIT_DEFAULT_TIMEOUT=600   # Server-side wait timeout (seconds)
# WAIT_POLL_INTERVAL=2       # How often the server polls state (seconds)
# MCP_BRIDGE_TIMEOUT=900     # HTTP bridge read timeout — must exceed WAIT_DEFAULT_TIMEOUT

# Agent reaper — stops idle/stale/over-aged agent containers in the background
# TASKMASTER_REAPER_ENABLED=true
# TASKMASTER_REAPER_INTERVAL=60        # seconds between reaper passes
# TASKMASTER_REAPER_IDLE_TIMEOUT=900   # 15 min: container with no claimed work → reap
# TASKMASTER_REAPER_STALE_TIMEOUT=7200 # 2 h: claimed work whose updated_at is older → reap + fail
# TASKMASTER_REAPER_MAX_AGE=14400      # 4 h: hard cap regardless of state
